# EDITH backend — configuration template (Milestone 1: Coding Service).
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# With no API key configured, the backend runs in OFFLINE MOCK MODE using a
# deterministic fake client — the app and tests work without credentials.
#
# Never commit real secrets.

# API key for the LLM provider (Anthropic). ANTHROPIC_API_KEY is also accepted.
EDITH_LLM_API_KEY=

# Model identifier used for code generation (default: claude-sonnet-5).
EDITH_LLM_MODEL=claude-sonnet-5

# Provider request timeout in seconds (default: 30).
EDITH_LLM_TIMEOUT=30

# Force offline mock mode even when an API key is set (1/true/yes/on).
EDITH_LLM_MOCK=
